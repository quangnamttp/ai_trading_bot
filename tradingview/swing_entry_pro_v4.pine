//@version=5
indicator("Swing Entry Pro v4 - S/R Theo Độ Mạnh + Cảnh Báo Sớm (không repaint)", overlay=true, max_lines_count=60, max_labels_count=100)

// ============ CHẾ ĐỘ GIAO DỊCH ============
grpMode = "Chế độ giao dịch"
swingMode = input.bool(true, "Chế độ Swing nhanh (nhiều lệnh/ngày)", group=grpMode)

// ============ XU HƯỚNG (EMA) ============
grpTrend = "Xu hướng (EMA)"
emaFastLen  = input.int(9,   "EMA nhanh", group=grpTrend)
emaSlowLen  = input.int(21,  "EMA chậm", group=grpTrend)
emaTrendLen = input.int(100, "EMA nền", group=grpTrend)

// ============ KHÁNG CỰ / HỖ TRỢ ============
grpSR = "Kháng cự / Hỗ trợ"
pivotLeft   = input.int(5, "Độ nhạy bên trái", minval=2, group=grpSR)
pivotRight  = input.int(5, "Độ nhạy bên phải", minval=2, group=grpSR)
maxSRLines  = input.int(2, "Số vùng hiển thị mỗi bên (ít = đỡ rối mắt)", minval=1, maxval=4, group=grpSR)
mergeTolPct = input.float(0.15, "Gộp các mức gần nhau (%)", minval=0.02, step=0.01, group=grpSR)
srTouchPct  = input.float(0.25, "Khoảng cách coi là 'chạm' vùng (%)", minval=0.05, step=0.05, group=grpSR)

// ============ CẢNH BÁO ĐẢO CHIỀU SỚM ============
grpRev = "Cảnh báo đảo chiều sớm"
rsiLen        = input.int(14, "Chu kỳ RSI", group=grpRev)
useDiv        = input.bool(true, "Dùng phân kỳ RSI", group=grpRev)
useCandle     = input.bool(true, "Dùng mẫu nến đảo chiều", group=grpRev)
warnValidBars = input.int(4, "Cảnh báo còn hiệu lực (số nến)", minval=1, group=grpRev)

// ============ KHỐI LƯỢNG ============
grpVol = "Khối lượng"
volMALen     = input.int(20, "Chu kỳ MA khối lượng", group=grpVol)
volSpikeMult = input.float(1.4, "Hệ số volume xác nhận", minval=1.0, step=0.1, group=grpVol)

// ============ QUẢN LÝ LỆNH ============
grpATR = "Quản lý lệnh (SL/TP)"
atrLen    = input.int(14, "Chu kỳ ATR", group=grpATR)
atrMultSL = input.float(1.2, "ATR x Stop Loss", minval=0.3, step=0.1, group=grpATR)
atrMultTP = input.float(2.0, "ATR x Take Profit", minval=0.3, step=0.1, group=grpATR)

// ============ ĐA KHUNG THỜI GIAN ============
grpMTF = "Đa khung thời gian"
useMTF     = input.bool(true, "Lọc tín hiệu theo đa khung (khuyên dùng)", group=grpMTF)
requireVote = input.int(2, "Cần ít nhất bao nhiêu khung lớn đồng thuận (trên tổng 3)", minval=1, maxval=3, group=grpMTF)
htfD  = input.timeframe("D",   "Khung 1 (mặc định D1)", group=grpMTF)
htfH4 = input.timeframe("240", "Khung 2 (mặc định H4)", group=grpMTF)
htfH1 = input.timeframe("60",  "Khung 3 (mặc định H1)", group=grpMTF)

// ============ GIỚI HẠN SỐ LỆNH MỖI NGÀY ============
grpLimit = "Giới hạn tần suất"
maxTradesPerDay = input.int(2, "Số lệnh MẠNH tối đa mỗi ngày", minval=1, maxval=10, group=grpLimit)

newDay = ta.change(time("D")) != 0
var int tradesToday = 0
if newDay
    tradesToday := 0
canTrade = tradesToday < maxTradesPerDay

// ============ ĐỊNH DẠNG GIÁ TỰ ĐỘNG (mọi loại coin) ============
f_fmt(x) => str.tostring(x, "#.##########")

// ============ XU HƯỚNG ============
calcTrend(src) =>
    ef = ta.ema(src, emaFastLen)
    es = ta.ema(src, emaSlowLen)
    et = ta.ema(src, emaTrendLen)
    isBull = swingMode ? ef > es : (src > et and ef > es)
    isBear = swingMode ? ef < es : (src < et and ef < es)
    [isBull, isBear]

[bullTrend, bearTrend] = calcTrend(close)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

plot(emaFast,  "EMA nhanh", color=color.new(color.orange, 0), linewidth=1)
plot(emaSlow,  "EMA chậm",  color=color.new(color.blue, 0),   linewidth=1)
plot(emaTrend, "EMA nền",   color=color.new(color.gray, 0),   linewidth=2)
bgcolor(bullTrend ? color.new(color.green, 95) : bearTrend ? color.new(color.red, 95) : na, title="Nền xu hướng")

// ============ ĐA KHUNG THỜI GIAN (D1 + H4 + H1 hiển thị đồng thời) ============
// v4: chỉ dùng nến khung lớn ĐÃ ĐÓNG ([1] + lookahead_on) -> tín hiệu live giống hệt lịch sử, không repaint.
// (v3 dùng lookahead_off: khi chạy live lấy nến D1/H4 đang chạy -> tín hiệu hiện rồi biến mất)
calcTrendConfirmed() =>
    [b, s] = calcTrend(close)
    [b[1], s[1]]
[dBull, dBear]   = request.security(syminfo.tickerid, htfD,  calcTrendConfirmed(), lookahead=barmerge.lookahead_on)
[h4Bull, h4Bear] = request.security(syminfo.tickerid, htfH4, calcTrendConfirmed(), lookahead=barmerge.lookahead_on)
[h1Bull, h1Bear] = request.security(syminfo.tickerid, htfH1, calcTrendConfirmed(), lookahead=barmerge.lookahead_on)

bullVotes = (dBull ? 1 : 0) + (h4Bull ? 1 : 0) + (h1Bull ? 1 : 0)
bearVotes = (dBear ? 1 : 0) + (h4Bear ? 1 : 0) + (h1Bear ? 1 : 0)

mtfBullOK = not useMTF or bullVotes >= requireVote
mtfBearOK = not useMTF or bearVotes >= requireVote

// ============ PIVOT + ĐẾM SỐ LẦN CHẠM ============
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLow  = ta.pivotlow(low, pivotLeft, pivotRight)

var float[] resLevels  = array.new_float(0)
var int[]   resTouches = array.new_int(0)
var float[] supLevels  = array.new_float(0)
var int[]   supTouches = array.new_int(0)

addLevel(arr, touchArr, lvl, tolPct) =>
    bool merged = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            existing = array.get(arr, i)
            if math.abs(lvl - existing) / existing * 100 < tolPct
                array.set(arr, i, (existing + lvl) / 2)
                array.set(touchArr, i, array.get(touchArr, i) + 1)
                merged := true
    if not merged
        array.push(arr, lvl)
        array.push(touchArr, 1)
    if array.size(arr) > 25
        array.shift(arr)
        array.shift(touchArr)

if not na(pivotHigh)
    addLevel(resLevels, resTouches, pivotHigh, mergeTolPct)
if not na(pivotLow)
    addLevel(supLevels, supTouches, pivotLow, mergeTolPct)

touchOf(arr, touchArr, val) =>
    idx = array.indexof(arr, val)
    idx >= 0 ? array.get(touchArr, idx) : 1

// Đánh dấu gọn điểm swing gốc
// v4: dấu X vẽ ĐÚNG nến được xác nhận (trễ pivotRight nến) thay vì vẽ lùi -> không tạo ảo giác "báo sớm"
plotshape(not na(pivotHigh), title="Đỉnh swing (đã xác nhận)", style=shape.xcross, location=location.abovebar, color=color.new(color.gray, 55), size=size.tiny)
plotshape(not na(pivotLow),  title="Đáy swing (đã xác nhận)",  style=shape.xcross, location=location.belowbar, color=color.new(color.gray, 55), size=size.tiny)

var line[]  resLines = array.new_line(0)
var line[]  supLines = array.new_line(0)
var label[] resLbls  = array.new_label(0)
var label[] supLbls  = array.new_label(0)

// Màu dịu, ít chói mắt: kháng cự = cam đất, hỗ trợ = xanh ngọc (thay vì đỏ/xanh neon)
resColorBase = color.rgb(214, 122, 62)
supColorBase = color.rgb(56, 158, 148)

if barstate.islast
    for l in resLines
        line.delete(l)
    for l in supLines
        line.delete(l)
    for lb in resLbls
        label.delete(lb)
    for lb in supLbls
        label.delete(lb)
    array.clear(resLines)
    array.clear(supLines)
    array.clear(resLbls)
    array.clear(supLbls)

    resAbove = array.new_float(0)
    if array.size(resLevels) > 0
        for v in resLevels
            if v > close
                array.push(resAbove, v)
    array.sort(resAbove, order.ascending)
    resN = math.min(maxSRLines, array.size(resAbove))
    if resN > 0
        for i = 0 to resN - 1
            lvl = array.get(resAbove, i)
            touches = touchOf(resLevels, resTouches, lvl)
            lw = touches >= 3 ? 3 : 2
            transp = touches >= 3 ? 10 : touches == 2 ? 35 : 55
            ln = line.new(bar_index - 60, lvl, bar_index + 12, lvl, color=color.new(resColorBase, transp), width=lw)
            lb = label.new(bar_index + 12, lvl, f_fmt(lvl) + (touches > 1 ? "  (chạm " + str.tostring(touches) + ")" : ""),
                 style=label.style_label_left, color=color.new(resColorBase, 15), textcolor=color.white, size=size.small)
            array.push(resLines, ln)
            array.push(resLbls, lb)

    supBelow = array.new_float(0)
    if array.size(supLevels) > 0
        for v in supLevels
            if v < close
                array.push(supBelow, v)
    array.sort(supBelow, order.descending)
    supN = math.min(maxSRLines, array.size(supBelow))
    if supN > 0
        for i = 0 to supN - 1
            lvl = array.get(supBelow, i)
            touches = touchOf(supLevels, supTouches, lvl)
            lw = touches >= 3 ? 3 : 2
            transp = touches >= 3 ? 10 : touches == 2 ? 35 : 55
            ln = line.new(bar_index - 60, lvl, bar_index + 12, lvl, color=color.new(supColorBase, transp), width=lw)
            lb = label.new(bar_index + 12, lvl, f_fmt(lvl) + (touches > 1 ? "  (chạm " + str.tostring(touches) + ")" : ""),
                 style=label.style_label_left, color=color.new(supColorBase, 15), textcolor=color.white, size=size.small)
            array.push(supLines, ln)
            array.push(supLbls, lb)

// Mức gần nhất để dùng cho logic (tính mỗi bar)
nearestRes = float(na)
nearestSup = float(na)
if array.size(resLevels) > 0
    tR = array.new_float(0)
    for v in resLevels
        if v > close
            array.push(tR, v)
    if array.size(tR) > 0
        array.sort(tR, order.ascending)
        nearestRes := array.get(tR, 0)
if array.size(supLevels) > 0
    tS = array.new_float(0)
    for v in supLevels
        if v < close
            array.push(tS, v)
    if array.size(tS) > 0
        array.sort(tS, order.descending)
        nearestSup := array.get(tS, 0)

nearSupport    = not na(nearestSup) and (close - nearestSup) / close * 100 <= srTouchPct
nearResistance = not na(nearestRes) and (nearestRes - close) / close * 100 <= srTouchPct

// ============ KHỐI LƯỢNG ============
volMA    = ta.sma(volume, volMALen)
volSpike = volume > volMA * volSpikeMult

// ============ RSI & PHÂN KỲ ============
rsi = ta.rsi(close, rsiLen)

var float lastPL = na
var float lastPLRSI = na
var float prevPL = na
var float prevPLRSI = na
var float lastPH = na
var float lastPHRSI = na
var float prevPH = na
var float prevPHRSI = na

if not na(pivotLow)
    prevPL := lastPL
    prevPLRSI := lastPLRSI
    lastPL := low[pivotRight]
    lastPLRSI := rsi[pivotRight]

if not na(pivotHigh)
    prevPH := lastPH
    prevPHRSI := lastPHRSI
    lastPH := high[pivotRight]
    lastPHRSI := rsi[pivotRight]

bullDiv = useDiv and not na(prevPL) and not na(pivotLow) and lastPL < prevPL and lastPLRSI > prevPLRSI
bearDiv = useDiv and not na(prevPH) and not na(pivotHigh) and lastPH > prevPH and lastPHRSI < prevPHRSI

// ============ MẪU NẾN ĐẢO CHIỀU ============
bullEngulf = useCandle and close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = useCandle and close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bodySize   = math.abs(close - open)
rangeVal   = high - low
hammer     = useCandle and rangeVal > 0 and (high - math.max(close, open)) < bodySize * 0.4 and (math.min(close, open) - low) > bodySize * 1.8
shootStar  = useCandle and rangeVal > 0 and (math.min(close, open) - low) < bodySize * 0.4 and (high - math.max(close, open)) > bodySize * 1.8

bullCandle = bullEngulf or hammer
bearCandle = bearEngulf or shootStar

// ============ CẢNH BÁO SỚM ============
earlyBullWarn = nearSupport and (bullDiv or bullCandle)
earlyBearWarn = nearResistance and (bearDiv or bearCandle)

var int barsSinceBullWarn = 9999
var int barsSinceBearWarn = 9999
barsSinceBullWarn := earlyBullWarn ? 0 : barsSinceBullWarn + 1
barsSinceBearWarn := earlyBearWarn ? 0 : barsSinceBearWarn + 1

plotshape(earlyBullWarn, title="Cảnh báo đảo chiều TĂNG", style=shape.diamond, location=location.belowbar, size=size.tiny, color=color.new(color.yellow, 0), text="?")
plotshape(earlyBearWarn, title="Cảnh báo đảo chiều GIẢM", style=shape.diamond, location=location.abovebar, size=size.tiny, color=color.new(color.yellow, 0), text="?")

// ============ ATR ============
atrVal = ta.atr(atrLen)

// ============ TÍN HIỆU VÀO LỆNH ============
crossUp   = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

buyConfirmRaw  = (crossUp or (bullCandle and nearSupport))     and volSpike and bullTrend and mtfBullOK
sellConfirmRaw = (crossDown or (bearCandle and nearResistance)) and volSpike and bearTrend and mtfBearOK

// Chỉ bắn tín hiệu ở nến ĐẦU TIÊN điều kiện đúng, tránh lặp lại liên tiếp nhiều nến gây rối nhãn SL/TP
// v4: chỉ xác nhận khi nến ĐÃ ĐÓNG (tránh tín hiệu nhấp nháy trong lúc nến đang chạy)
buyConfirm  = buyConfirmRaw  and not buyConfirmRaw[1]  and barstate.isconfirmed
sellConfirm = sellConfirmRaw and not sellConfirmRaw[1] and barstate.isconfirmed

buyBest  = buyConfirm  and barsSinceBullWarn <= warnValidBars and canTrade
sellBest = sellConfirm and barsSinceBearWarn <= warnValidBars and canTrade

if buyBest or sellBest
    tradesToday := tradesToday + 1

plotshape(buyConfirm and not buyBest,   title="MUA",       location=location.belowbar, style=shape.triangleup,   size=size.small,  color=color.new(color.green, 0),  text="MUA")
plotshape(sellConfirm and not sellBest, title="BÁN",       location=location.abovebar, style=shape.triangledown, size=size.small,  color=color.new(color.red, 0),    text="BÁN")
plotshape(buyBest,  title="MUA MẠNH", location=location.belowbar, style=shape.triangleup,   size=size.normal, color=color.new(color.lime, 0),   text="MUA★")
plotshape(sellBest, title="BÁN MẠNH", location=location.abovebar, style=shape.triangledown, size=size.normal, color=color.new(color.maroon, 0), text="BÁN★")

if buyConfirm
    sl = close - atrVal * atrMultSL
    tp = close + atrVal * atrMultTP
    label.new(bar_index, low, "SL " + f_fmt(sl) + "\nTP " + f_fmt(tp), style=label.style_label_up,
         color=color.new(buyBest ? color.lime : color.green, 60), textcolor=color.white, size=size.small)

if sellConfirm
    sl = close + atrVal * atrMultSL
    tp = close - atrVal * atrMultTP
    label.new(bar_index, high, "SL " + f_fmt(sl) + "\nTP " + f_fmt(tp), style=label.style_label_down,
         color=color.new(sellBest ? color.maroon : color.red, 60), textcolor=color.white, size=size.small)

// ============ HIỂN THỊ BẢNG TRẠNG THÁI ============
grpTable = "Bảng trạng thái"
showTable   = input.bool(true, "Hiện bảng trạng thái", group=grpTable)
compactMode = input.bool(true, "Chế độ thu gọn (chỉ hiện dòng quan trọng)", group=grpTable)
tablePos    = input.string("Trên phải", "Vị trí bảng", options=["Trên phải", "Trên trái", "Dưới phải", "Dưới trái"], group=grpTable)

f_tablePos(p) =>
    p == "Trên phải" ? position.top_right : p == "Trên trái" ? position.top_left : p == "Dưới phải" ? position.bottom_right : position.bottom_left

trendLbl(b, s) => b ? "TĂNG" : s ? "GIẢM" : "NGANG"
trendClr(b, s) => b ? color.green : s ? color.red : color.orange

if showTable
    if compactMode
        var table infoC = table.new(f_tablePos(tablePos), 2, 3, border_width=1)
        if barstate.islast
            table.cell(infoC, 0, 0, "Xu hướng", bgcolor=color.gray, text_color=color.white, text_size=size.small)
            table.cell(infoC, 1, 0, trendLbl(bullTrend, bearTrend), bgcolor=trendClr(bullTrend, bearTrend), text_color=color.white, text_size=size.small)
            table.cell(infoC, 0, 1, "RSI", bgcolor=color.gray, text_color=color.white, text_size=size.small)
            table.cell(infoC, 1, 1, str.tostring(rsi, "#.##"), bgcolor=color.new(color.blue, 60), text_color=color.white, text_size=size.small)
            table.cell(infoC, 0, 2, "Lệnh hôm nay", bgcolor=color.gray, text_color=color.white, text_size=size.small)
            table.cell(infoC, 1, 2, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay), bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)
    else
        var table infoF = table.new(f_tablePos(tablePos), 2, 8, border_width=1)
        if barstate.islast
            table.cell(infoF, 0, 0, "Khung hiện tại", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 0, trendLbl(bullTrend, bearTrend), bgcolor=trendClr(bullTrend, bearTrend), text_color=color.white)
            table.cell(infoF, 0, 1, "Xu hướng H1", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 1, trendLbl(h1Bull, h1Bear), bgcolor=trendClr(h1Bull, h1Bear), text_color=color.white)
            table.cell(infoF, 0, 2, "Xu hướng H4", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 2, trendLbl(h4Bull, h4Bear), bgcolor=trendClr(h4Bull, h4Bear), text_color=color.white)
            table.cell(infoF, 0, 3, "Xu hướng D1", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 3, trendLbl(dBull, dBear), bgcolor=trendClr(dBull, dBear), text_color=color.white)
            table.cell(infoF, 0, 4, "RSI", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 4, str.tostring(rsi, "#.##"), bgcolor=color.new(color.blue, 60), text_color=color.white)
            table.cell(infoF, 0, 5, "Hỗ trợ gần nhất", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 5, na(nearestSup) ? "—" : f_fmt(nearestSup), bgcolor=color.new(supColorBase, 60), text_color=color.white)
            table.cell(infoF, 0, 6, "Kháng cự gần nhất", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 6, na(nearestRes) ? "—" : f_fmt(nearestRes), bgcolor=color.new(resColorBase, 60), text_color=color.white)
            table.cell(infoF, 0, 7, "Lệnh mạnh hôm nay", bgcolor=color.gray, text_color=color.white)
            table.cell(infoF, 1, 7, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), bgcolor=color.new(color.purple, 50), text_color=color.white)

// ============ ALERT ============
alertcondition(buyBest,       "MUA MẠNH",                "Cảnh báo sớm + xác nhận đúng hướng -> điểm MUA tốt")
alertcondition(sellBest,      "BÁN MẠNH",                "Cảnh báo sớm + xác nhận đúng hướng -> điểm BÁN tốt")
alertcondition(earlyBullWarn, "Cảnh báo đảo chiều TĂNG", "Giá gần hỗ trợ, có dấu hiệu đảo chiều tăng")
alertcondition(earlyBearWarn, "Cảnh báo đảo chiều GIẢM", "Giá gần kháng cự, có dấu hiệu đảo chiều giảm")
