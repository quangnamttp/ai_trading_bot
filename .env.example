# --- Bắt buộc ---
TELEGRAM_BOT_TOKEN=123456:ABC...        # lấy từ @BotFather
ADMIN_IDS=123456789                      # Telegram ID của bạn (lấy từ @userinfobot), nhiều ID cách nhau dấu phẩy

# --- Lưu trữ ---
# Local: để mặc định SQLite. Render: dùng Postgres miễn phí của Neon (neon.tech), dán connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///bot.db

# --- Webhook (Render tự cấp RENDER_EXTERNAL_URL; để trống khi chạy máy cá nhân => polling) ---
PUBLIC_URL=
WEBHOOK_SECRET=
PORT=8080

# --- Tín hiệu ---
TOP_N=30                     # quét top N coin theo khối lượng Binance Futures
MIN_QUOTE_VOLUME=20000000    # khối lượng 24h tối thiểu (USD)
MAX_SIGNALS_PER_DAY=5
MAX_SIGNALS_PER_SCAN=2
MAX_OPEN_SIGNALS=6
MAX_HOLD_HOURS=168           # giữ lệnh tối đa 7 ngày
DEFAULT_RISK_PCT=0.5         # % vốn rủi ro mỗi lệnh mặc định cho người dùng mới
MAX_LEVERAGE=10
# SCORE_THRESHOLD=75         # mặc định lấy từ app/strategy/calibration.json

# --- Tùy chọn ---
CRYPTOPANIC_TOKEN=           # thêm nguồn tin có vote cộng đồng (miễn phí)
LOG_LEVEL=INFO
